generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Salesperson {
  id   Int    @id @default(autoincrement())
  name String @unique

  leads        Lead[]
  contactDays  LeadContactDay[]
  appointments Appointment[]
}

model Lead {
  id          Int        @id @default(autoincrement())
  name        String
  email       String     @unique
  phone       String?
  vehicleName String?
  dateOfBirth DateTime?  @db.Date
  source      String?
  status      LeadStatus @default(NEW)
  notes       String?

  salespersonId Int?
  salesperson   Salesperson? @relation(fields: [salespersonId], references: [id])

  lastContactedAt DateTime?

  contactDays  LeadContactDay[]
  activities   LeadActivity[]
  appointments Appointment[]

  contractSignedAt DateTime?
  wonAt            DateTime?
  deliveredAt      DateTime?
  lostAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum LeadStatus {
  NEW
  HOT
  CONTACTED
  APPOINTMENT
  CONTACT_UNSUCCESSFUL
  CONTRACT_SIGNED
  WON
  DELIVERED
  LOST
}

enum ContactOutcome {
  SUCCESSFUL
  UNSUCCESSFUL
}

model LeadContactDay {
  id              Int            @id @default(autoincrement())
  leadId          Int
  salespersonId   Int?
  contactDate     DateTime       @db.Date
  outcome         ContactOutcome
  lastContactedAt DateTime

  lead        Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  salesperson Salesperson? @relation(fields: [salespersonId], references: [id])

  @@unique([leadId, contactDate])
}

model LeadActivity {
  id        String       @id @default(cuid())
  leadId    Int
  type      ActivityType
  content   String
  createdAt DateTime     @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}

enum ActivityType {
  CALL
  SMS
  NOTE
  APPOINTMENT
  STATUS_CHANGE
}

model Appointment {
  id            Int               @id @default(autoincrement())
  leadId        Int?
  salespersonId Int?
  customerName  String
  customerPhone String?
  customerEmail String?
  vehicleName   String?
  type          AppointmentType   @default(TEST_DRIVE)
  status        AppointmentStatus @default(SCHEDULED)
  scheduledAt   DateTime
  notes         String?

  lead        Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  salesperson Salesperson? @relation(fields: [salespersonId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scheduledAt])
  @@index([leadId])
}

enum AppointmentType {
  TEST_DRIVE
  VEHICLE_SELLING
  OTHER
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum FinanceApplicationStatus {
  // Internal application stages
  LINK_SENT
  IN_PROGRESS
  SUBMITTED

  // Finance processing statuses
  RECEIVED
  SENT_TO_BROKER
  UNDER_REVIEW
  ADDITIONAL_INFO_REQUIRED
  SENT_TO_LENDER
  CONDITIONALLY_APPROVED
  APPROVED
  DECLINED
  SETTLED
}

model FinanceApplication {
  id            String  @id @default(cuid())
  inquiryNumber Int     @unique @default(autoincrement())
  tokenHash     String  @unique
  phone         String
  customerName  String?

  status FinanceApplicationStatus @default(LINK_SENT)

  email           String?
  dateOfBirth     DateTime?
  address         String?
  employmentType  String?
  employer        String?
  monthlyIncome   Decimal?  @db.Decimal(12, 2)
  monthlyExpenses Decimal?  @db.Decimal(12, 2)
  loanAmount      Decimal?  @db.Decimal(12, 2)
  loanPurpose     String?

  formData          Json?
  applicationType   String?
  applicantType     String?
  documents         FinanceDocument[]
  consentRecordedAt DateTime?

  retentionReviewAt DateTime?
  legalHold         Boolean   @default(false)
  legalHoldReason   String?

  assignedStaffId String?
  assignedStaff   PortalUser? @relation("ApplicationStaff", fields: [assignedStaffId], references: [id], onDelete: SetNull)

  assignedBrokerId String?
  assignedBroker   PortalUser? @relation("ApplicationBroker", fields: [assignedBrokerId], references: [id], onDelete: SetNull)

  // Unused - please note in the future development
  brokerDisclosureAuthorised   Boolean   @default(false)
  brokerDisclosureAuthorisedAt DateTime?
  brokerDisclosureAuthorisedBy String?
  brokerDisclosureEvidence     String?

  smsSentAt   DateTime?
  startedAt   DateTime?
  submittedAt DateTime?
  reviewedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletionInProgress Boolean @default(false)

  @@index([assignedStaffId])
  @@index([assignedBrokerId])
}

enum PortalRole {
  STAFF
  BOSS
  BROKER
}

model PortalUser {
  id           String     @id @default(cuid())
  name         String
  email        String?    @unique
  phone        String?
  role         PortalRole
  passwordHash String?

  brokerageId String?
  brokerage   Brokerage? @relation(fields: [brokerageId], references: [id])

  assignedStaffApplications  FinanceApplication[] @relation("ApplicationStaff")
  assignedBrokerApplications FinanceApplication[] @relation("ApplicationBroker")

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([brokerageId])
}

model Brokerage {
  id    String       @id @default(cuid())
  name  String       @unique
  users PortalUser[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BrokerAssignmentHistory {
  id String @id @default(cuid())

  applicationId String
  assignedById  String
  brokerId      String

  previousBrokerId String?
  previousStatus   String
  newStatus        String

  createdAt DateTime @default(now())

  @@index([applicationId, createdAt])
  @@index([assignedById])
  @@index([brokerId])
}

model StaffAssignmentHistory {
  id              String   @id @default(cuid())
  applicationId   String
  assignedById    String
  staffId         String
  previousStaffId String?
  createdAt       DateTime @default(now())

  @@index([applicationId, createdAt])
}

model FinanceStatusHistory {
  id             String                   @id @default(cuid())
  applicationId  String
  changedById    String
  previousStatus FinanceApplicationStatus
  newStatus      FinanceApplicationStatus
  note           String?
  createdAt      DateTime                 @default(now())

  @@index([applicationId, createdAt])
  @@index([changedById])
}

model FinanceDocument {
  id            String   @id @default(cuid())
  applicationId String
  category      String
  originalName  String
  storageKey    String   @unique
  mimeType      String
  sizeBytes     Int
  uploadedAt    DateTime @default(now())

  application FinanceApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model DocumentAccessLog {
  id            String   @id @default(cuid())
  applicationId String
  documentId    String
  accessedById  String
  action        String   @default("DOCUMENT_DOWNLOAD")
  createdAt     DateTime @default(now())

  @@index([applicationId])
  @@index([documentId])
  @@index([accessedById])
  @@index([createdAt])
}

model ApplicationEditAuditLog {
  id                 String   @id @default(cuid())
  applicationId      String
  editorId           String
  editorRole         String
  changedFields      Json
  authorityConfirmed Boolean  @default(false)
  createdAt          DateTime @default(now())

  @@index([applicationId, createdAt])
  @@index([editorId])
}

model FinanceDeletionAudit {
  id              String   @id @default(cuid())
  applicationId   String
  requestedById   String
  approvedById    String?
  reason          String
  status          String   @default("REQUESTED")
  documentCount   Int      @default(0)
  requestedAt     DateTime @default(now())
  approvedAt      DateTime?
  completedAt     DateTime?
  failureReason   String?

  @@index([applicationId])
  @@index([requestedById])
  @@index([status])
  @@index([requestedAt])

  approvalExpiresAt DateTime?
  retentionVerifiedAt DateTime?

  executionStartedAt DateTime?
  lastCleanupAttemptAt DateTime?
}

model FinanceDeletionDocument {
  id                String    @id @default(cuid())
  deletionAuditId   String
  documentId        String
  storageKey        String
  status            String    @default("PENDING")
  quarantinedAt     DateTime?
  deletedAt         DateTime?
  lastError         String?

  @@unique([deletionAuditId, documentId])
  @@index([deletionAuditId, status])
  @@index([storageKey])
}

model PrivacyRequest {
  id                  String    @id @default(cuid())
  applicationId       String?
  requestType         String
  requesterName       String
  requesterContact    String
  receivedById        String
  receivedAt          DateTime  @default(now())
  identityVerified    Boolean   @default(false)
  identityVerifiedAt  DateTime?
  identityVerifiedBy  String?
  status              String    @default("RECEIVED")
  resolutionNote      String?
  followUpRequired    Boolean   @default(false)
  completedAt         DateTime?
  updatedAt           DateTime  @updatedAt

  @@index([applicationId])
  @@index([status, receivedAt])
}

model SecurityIncident {
  id                  String    @id @default(cuid())
  incidentType        String
  severity            String    @default("UNASSESSED")
  status              String    @default("REPORTED")
  summary             String
  reportedById        String
  reportedAt          DateTime  @default(now())

  assignedToId        String?
  investigationNotes  String?
  affectedDataTypes   Json?
  affectedRecordCount Int?

  containedAt         DateTime?
  containmentNotes    String?

  notificationRequired Boolean?
  notificationDecisionAt DateTime?
  notificationNotes   String?
  oaicNotifiedAt      DateTime?
  customersNotifiedAt DateTime?

  recoveredAt         DateTime?
  recoveryNotes       String?
  closedAt            DateTime?
  postIncidentReview  String?

  updatedAt           DateTime  @updatedAt

  @@index([status, reportedAt])
  @@index([severity])
  @@index([reportedById])
}


model SmsMessage {
  id             String   @id @default(cuid())

  applicationId  String?
  recipientPhone String

  // FINANCE_APPLICATION_LINK or BROKER_CONSENT
  messageType    String

  provider       String   @default("MOCK")
  providerSid    String?  @unique
  status         String   @default("PENDING")

  // Prevent duplicate sends for the same event.
  idempotencyKey String   @unique

  requestedById  String?
  brokerId       String?

  attemptCount   Int      @default(0)
  lastError      String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  sentAt         DateTime?
  deliveredAt    DateTime?
  failedAt       DateTime?

  @@index([applicationId])
  @@index([recipientPhone])
  @@index([messageType, status])
  @@index([createdAt])
}
